APP_NAME=RibkaYoga
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ribka
DB_USERNAME=ribka
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME=RibkaYoga

# Personal audio: executable paths or commands available in PHP's PATH.
AUDIO_FFMPEG_BINARY=ffmpeg
AUDIO_FFPROBE_BINARY=ffprobe
AUDIO_MAX_BYTES=104857600
AUDIO_MAX_SECONDS=7200
AUDIO_LIBRARY_MAX_BYTES=1073741824
AUDIO_DECODE_TIMEOUT=180

# Set real SMTP values on the server before switching MAIL_MAILER to smtp.
# MAIL_SCHEME=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
